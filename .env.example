NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Contact form — enquiries notify this address (also shown on the website)
CONTACT_NOTIFY_EMAIL=neil.tomalin@ellesmere.com
# Optional: instant email via Resend when an enquiry is submitted (DB insert always runs)
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=ECI Website <notifications@yourdomain.com>

# Optional legacy fallback only — prefer auto-created DB links via Team → Doc intake
# DOCUMENT_INTAKE_TOKEN=

# Document articulation + portal chat
# Recommended for articulation: Anthropic Claude Sonnet 4
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Or: LLM_API_KEY= (used if ANTHROPIC_API_KEY is unset)
# Prefer claude-sonnet-4-6 (Sonnet 4 line) or claude-sonnet-5. Do not use claude-sonnet-4-20250514 (retired).
LLM_MODEL=claude-sonnet-4-6

# Only needed for OpenAI-compatible providers (OpenAI, OpenRouter, Azure, etc.)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
